# EduAgent Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# JWT Authentication
JWT_SECRET=edumind_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Configuration
# Replace <db_password> with your MongoDB database user password
MONGODB_URI=mongodb+srv://CHITRA:<db_password>@cluster0.jtoswvx.mongodb.net/edumind_db?appName=Cluster0
MONGODB_DB_NAME=edumind_db

# LLM Providers (OpenAI & Ollama)
LLM_PROVIDER=auto
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Multi-Agent Configuration
ENABLE_CREWAI=true
ENABLE_LANGGRAPH=true
ENABLE_MCP=true

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-small
